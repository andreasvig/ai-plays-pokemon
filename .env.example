OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Online leaderboard: Cloudflare R2 (artifacts/online-leaderboard/plan.md) ──
# `pokemon publish` uploads recordings and screenshots here and deletes them on
# `pokemon unpublish`, so the token needs Object Read & Write on THIS bucket
# only. Where to find each value in the Cloudflare dashboard:
#
#   R2_ACCOUNT_ID         R2 overview page, right-hand column "Account ID"
#                         (also the first segment of the S3 endpoint
#                         https://<account_id>.r2.cloudflarestorage.com).
#   R2_ACCESS_KEY_ID      R2 → Manage R2 API Tokens → Create API token →
#   R2_SECRET_ACCESS_KEY  Permissions: "Object Read & Write" → Specify bucket(s):
#                         the bucket below → Create. Copy both values from the
#                         confirmation page; the secret is shown ONCE.
#   R2_BUCKET             The bucket name you created (R2 → Create bucket).
#   R2_PUBLIC_BASE_URL    Bucket → Settings → Public access → "R2.dev subdomain"
#                         → Allow Access. Paste the URL shown (no trailing slash).
#                         A custom domain connected there works the same way.
R2_ACCOUNT_ID=your-32-hex-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=ai-plays-pokemon
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
# Optional: where the static site is served. Derived from the git remote
# (https://<user>.github.io/<repo>/) when unset; set it once a custom domain
# fronts GitHub Pages.
# PAGES_BASE_URL=https://pokebench.example.com
